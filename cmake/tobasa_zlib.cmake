macro(tobasa_configure_bundled_zlib)
   if(TOBASA_USE_BUNDLED_ZLIB)
      message(STATUS "Tobasa: using bundled zlib library")
      add_subdirectory(${TOBASA_EXTERNAL_DEPS_DIR}/zlib ${CMAKE_BINARY_DIR}/_exts/zlib EXCLUDE_FROM_ALL)
      #add_subdirectory(${TOBASA_EXTERNAL_DEPS_DIR}/minizip ${CMAKE_BINARY_DIR}/_exts/minizip EXCLUDE_FROM_ALL)
   elseif(TOBASA_FIND_DEPS OR TOBASA_BUILD_WITH_VCPKG)
      find_package(ZLIB REQUIRED)
   endif()
endmacro()