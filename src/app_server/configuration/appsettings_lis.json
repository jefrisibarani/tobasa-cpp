      // "dbDriver": "ODBC",
      // "connectionString": "Driver={ODBC Driver 17 for SQL Server};Server=10.0.0.2;Database=tobasa_lis${DBSUFFIX};UID=tbs_user;APP=ws_tcxx;TrustServerCertificate=Yes;",
      // "password": "27CA998DA4C4D345BC0C86F62B7C81BA",

      // "dbDriver": "PGSQL",
      // "connectionString": "dbname=tobasa_lis${DBSUFFIX} user=tbs_user hostaddr=10.62.22.2 port=5462",
      // "password": "27CA998DA4C4D345BC0C86F62B7C81BA",

      "dbDriver": "MYSQL",
      "connectionString": "Database=tobasa_lis${DBSUFFIX};User=tbs_user;Server=10.62.22.2;Port=3306;",
      "password": "27CA998DA4C4D345BC0C86F62B7C81BA",

      "logInternalSqlQuery": false,
      "logSqlQuery": false
   },
   // Run the LIS Engine on a dedicated thread, separate from the web service.
   // If set to false, the LIS Engine will use a thread allocated by the web service,
   // and the web service's ioPoolSize value must be greater than 1.
   "useDedicatedRunningThread": true,
   // Create new DbService/database connection to retrieve data from database
   "getDbDataWithNewConnection": true
}