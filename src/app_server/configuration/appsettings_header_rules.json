{
   "cacheControl" : [
      {
         "host": ["10.0.0.2:8085"],
         "requestPath": ["*"],
         "rules": [
            {
               "pattern": "\\.(ico|jpg|jpeg|png|gif|svg|webp|avif)$",
               "header": "public, max-age=31536000, immutable"
            },
            {
               "pattern": "\\.(css|js|woff|woff2|ttf|eot)$",
               "header": "public, max-age=31536000, immutable"
            },
            {
               "pattern": "\\.(mp4|webm|ogg|mp3|wav)$",
               "header": "public, max-age=31536000, immutable"
            },
            {
               "pattern": "\\.(html|htm)$",
               "header": "no-cache"
            }
         ]
      },
      {
         "host": ["alklin.local:9443", "devel.local:9443"],
         "requestPath": ["/ohif", "/dicomweb", "/rs", "/pacs"],
         "rules": [
            {
               "pattern": "\\.(ico|jpg|jpeg|png|gif|svg|webp|avif)$",
               "header": "public, max-age=31536000, immutable"
            },
            {
               "pattern": "\\.(css|js|woff|woff2|ttf|eot)$",
               "header": "public, max-age=31536000, immutable"
            },
            {
               "pattern": "\\.(mp4|webm|ogg|mp3|wav)$",
               "header": "public, max-age=31536000, immutable"
            },
            {
               "pattern": "\\.(html|htm)$",
               "header": "no-cache"
            }
         ]
      },
      {
         "host": ["*"],
         "requestPath": ["*"],
         "rules": [
            {
               "pattern": "*",
               "header": "no-store"
            }
         ]
      }
   ],
   "headerRule": [
      {
         "type": "none",
         "hostOrigin": ["*"],
         "requestPath": ["/"],
         "headers": [
            {"key":"X-Powered-By", "value": "Tobasa 1.0.0"}
         ]
      },
      {
         "type": "none",
         "hostOrigin": ["*"],
         "requestPath": ["/login", "/register", "/dashboard", "/admin" ],
         "headers": [
            {"key":"X-Frame-Options", "value": "DENY"}
         ]
      },
      {
         "type": "none",
         "hostOrigin": ["localhost:*", "127.0.0.1:*", "192.168.*.*:*", "alklin.local:*" ],
         "requestPath": ["/" ],
         "headers": [
            {"key":"Cross-Origin-Embedder-Policy",  "value": "require-corp"},
            {"key":"Cross-Origin-Opener-Policy",    "value": "same-origin"},
            {"key":"Cross-Origin-Resource-Policy",  "value": "same-origin"}
         ]
      },
      {
         "type": "cors",
         "hostOrigin": ["https://localhost:*", "https://127.0.0.1:*", "https://192.168.*.*:*", "https://alklin.local:*" ],
         "requestPath": ["/ohif", "/dicomweb", "/rs", "/pacs"],
         "headers": [
            {"key":"Access-Control-Allow-Origin",      "value": "dynamic"},
            {"key":"Access-Control-Allow-Credentials", "value": "true"},
            {"key":"Access-Control-Allow-Methods",     "value": "GET, POST, PUT, DELETE, OPTIONS, HEAD"},
            {"key":"Access-Control-Allow-Headers",     "value": "*"},
            {"key":"Access-Control-Expose-Headers",    "value": "*"}
         ]
      },
      {
         "type": "cors",
         "hostOrigin": ["https://localhost:8085", "https://devel.local:9443"],
         "requestPath": ["/api", "/chat", "/logout"],
         "headers": [
            {"key":"Access-Control-Allow-Origin",      "value": "dynamic"},
            {"key":"Access-Control-Allow-Credentials", "value": "true"},
            {"key":"Access-Control-Allow-Methods",     "value": "GET, POST, PUT, DELETE, OPTIONS, HEAD"},
            {"key":"Access-Control-Allow-Headers",     "value": "Cookie,Authorization,Content-Type,User-Agent,X-ChatProto-Version,X-Client-App-Id,X-Device-Token,X-Project-Id,X-WebService-Version"},
            {"key":"Access-Control-Expose-Headers",    "value": "Content-Disposition"}
         ]
      }
   ]
}